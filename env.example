APP_ENV=development
DATABASE_URL=sqlite:///./data/jobs.db
SCAN_INTERVAL_MINUTES=60
REQUEST_TIMEOUT=20
MAX_CONCURRENT_REQUESTS=3
REQUEST_RATE_PER_SECOND=1.0
DEFAULT_LOCATION=Berlin
DEFAULT_RADIUS_KM=20
MIN_MATCH_SCORE=70
USER_AGENT=BerlinJobRadar/1.0 (+personal job discovery)
DISCOVERY_ENABLED=true
DISCOVERY_PROVIDER=duckduckgo
DISCOVERY_MAX_RESULTS=10
SOURCE_URLS=

# Required to protect remote browser login endpoints when using the Render VNC login flow
DASHBOARD_ACCESS_TOKEN=change-me-to-a-long-random-secret
CHROMIUM_PATH=/usr/bin/chromium
