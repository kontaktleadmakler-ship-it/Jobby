APP_ENV=production
DATABASE_URL=sqlite:///./data/jobs.db
SCAN_INTERVAL_MINUTES=60
REQUEST_TIMEOUT=20
MAX_CONCURRENT_REQUESTS=3
REQUEST_RATE_PER_SECOND=1.0
DEFAULT_LOCATION=Berlin
DEFAULT_RADIUS_KM=20
MIN_MATCH_SCORE=70
USER_AGENT=JobbyJobSearch/1.0 (+personal job discovery)
DISCOVERY_ENABLED=true
DISCOVERY_PROVIDER=bing
DISCOVERY_MAX_RESULTS=10
DISCOVERY_TIMEOUT=8
DASHBOARD_ACCESS_TOKEN=change-me-to-a-long-random-secret
CHROMIUM_PATH=/usr/bin/chromium
